# External FV tool paths — set up + smoke-tested 2026-07-17. `source` this to use them.
# None are vendored; each was installed/built locally. Smoke commands in comments.
# GitHub project is now "PQ1" (was PQSigner_OS); GitHub redirects the old remote URL.

# ── Verus 0.2026.07.12 (prebuilt; needs rust toolchain 1.96.0, installed via rustup) ──
export VERUS=/home/nicola/Downloads/verus-0.2026.07.12.0b42f4c-x86-linux/verus-x86-linux/verus
export CARGO_VERUS_DIR=/home/nicola/Downloads/verus-0.2026.07.12.0b42f4c-x86-linux/verus-x86-linux
export PATH="$CARGO_VERUS_DIR:$PATH"   # provides `verus` + `cargo-verus`
# smoke: verus --version ; verus file.rs   (code inside `verus! { ... }`)  -> "N verified, 0 errors"

# ── SAW 1.5.1 + Cryptol 3.5.0 + solvers (z3/cvc4/cvc5/yices/bitwuzla/abc) + crux-mir-comp ──
export SAW_BIN=/home/nicola/Downloads/saw-1.5.1-ubuntu-24.04-X64-with-solvers/bin
export PATH="$SAW_BIN:$PATH"
# smoke: saw --version ; cryptol --version ; echo ':prove \(x:[16]) -> x+0==x' | cryptol -b /dev/stdin  -> Q.E.D.

# ── mir-json + crux-mir (Rust symbolic execution) ──
# mir-json is pinned to the SCHEMA-8 commit 48d0b4b2 (crux-mir-comp in SAW 1.5.1 only accepts
# schema 8; master emits 11). Built with nightly-2025-09-14 (+rustc-dev,rust-src) and a CLEAN
# PATH (no ~/.nix-profile) so the linker is the system cc, not Nix's (Nix cc bakes a nix-glibc
# interpreter that mismatches rustup's librustc_driver). `crux-mir` is a symlink -> crux-mir-comp.
export CRUX_RUST_LIBRARY_PATH=/home/nicola/repos/mir-json/rlibs   # translated stdlibs (schema 8)
export PATH="$HOME/.cargo/bin:$PATH"                              # mir-json, cargo-crux-test, crux-mir
# smoke (in a crate with a #[cfg_attr(crux, crux::test)] fn): cargo crux-test  -> "Overall status: Valid."
# BUILD/RUN mir-json with a PATH that EXCLUDES ~/.nix-profile (nix cc contaminates the interpreter).
# To move mir-json back to master (schema 11): git -C ~/repos/mir-json checkout master — but then it
# needs a schema-11 crux; SAW 1.5.1's crux-mir-comp is schema 8, so stay on 48d0b4b2 for this crux.

# ── Nanoda (independent Lean-4 kernel type-checker, export replay) ──
export NANODA=/home/nicola/repos/nanoda_lib/target/release/nanoda_bin
# smoke: "$NANODA" --help   (checks a Lean 4 export from github.com/leanprover/lean4export)

