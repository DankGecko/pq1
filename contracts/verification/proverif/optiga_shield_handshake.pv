(* ===========================================================================
   PQ-Signer — OPTIGA Trust M Shielded Connection handshake (ProVerif)
   ===========================================================================

   The OPTIGA-side companion to scp03_handshake.pv: models the Infineon Shielded
   Connection that establishes the encrypted tunnel `dual_se_unlock.pv` abstracts
   as a pre-shared key, so BOTH SE tunnels now have a handshake model.

   Mechanism (secure/src/optiga/shield.rs):
     root of trust : Platform Binding Secret (PBS) at OID 0xE140 (64 B, factory-
                     provisioned, DHUK-wrapped) — the invariant-#3 S2 asset.
     key derivation: TLS 1.2 PRF (HMAC-SHA256) over PBS + exchanged nonces.
     channel       : AES-128-CCM-8 (authenticated encryption).
   The host (S-world) opens the shielded connection, the F1D0/E120 silicon gate
   authorises the read, and OPTIGA returns `half_O` over the channel.

   ***********************************************************************
   * KNOWN INFIDELITY (found 2026-07-17 by work-todo M3 — READ THIS FIRST) *
   ***********************************************************************
   THIS MODEL INVENTS A HOST NONCE THE PROTOCOL DOES NOT HAVE. The `host` leg
   below does `new hrnd`, publishes it, and derives `prf(pbs, hrnd, ornd)` — a
   two-nonce exchange. Infineon's reference implementation
   (`github.com/Infineon/optiga-trust-m` v5.6.0,
   `src/comms/ifx_i2c/ifx_i2c_presentation_layer.c`) shows the real handshake has
   exactly ONE nonce and the host does not supply it:
     :497       prl.random is memcpy'd OUT OF the received SlaveHello — it is
                never generated here; there is no RNG call in the whole PRL.
     :302-313   the TLS-PRF seed is prl.random ALONE
                => session_key = PRF(PBS, "Platform Binding", random_S).
   `shield.rs` states this correctly ("Infineon PRL does NOT send a master
   random"); this model, derived FROM shield.rs, contradicts it anyway — which
   is exactly what a driver-derived model is worth.

   CONSEQUENCE, MEASURED: the host here can unilaterally guarantee session-key
   freshness with its own fresh nonce. In reality it contributes NONE. Run the
   same injective-agreement query on both models:
     this file                             : inj-event(HostAccepted) ==> ...  TRUE
     optiga_shield_handshake_vendor.pv     : inj-event(HostAcceptedOpt) ==> .. FALSE
   Same property, two answers. **Do not cite any freshness, replay or
   session-distinctness property from this file.**

   STILL SOUND HERE (unaffected by the invented nonce, and gate-pinned):
   half_O confidentiality, the two NON-injective mutual-agreement
   correspondences, and the PBS-leak residual — none of which depend on who
   contributed the nonce.

   The authoritative handshake model is now
   `optiga_shield_handshake_vendor.pv`, re-derived from the vendor source. This
   file is retained as the SCP03-companion shape and as the honest record of the
   divergence (and because its non-injective results are independently pinned).

   ABSTRACTIONS (stated): PBS as one symbolic key; TLS-PRF / cryptograms /
   AES-CCM-8 as symbolic functions (perfect crypto); the exact 4-step framing
   abstracted to a nonce-exchange + PRF-derived session key. Faithful for the
   mutual authentication and half_O-confidentiality questions below —
   NOT for freshness (see the infidelity note above). (Finding F3:
   the session key `s = prf(pbs, hrnd, ornd)` is never leaked — a STRUCTURAL
   consequence of PBS-secrecy, since PBS is never output — but that is NOT a
   separately-queried RESULT here; the shipped queries ask mutual-auth + half_O
   confidentiality only, so this docstring no longer advertises "session-key secrecy"
   as a third proven question.)

   NOTE: half_O is ONE XOR half — by Claim 1 it is useless without half_E (proved
   in dual_se_unlock.pv). So the residual here is a channel-confidentiality fact,
   strictly weaker than scp03_handshake.pv's PIN-recovery residual.
   =========================================================================== *)

type key.

fun senc(bitstring, key): bitstring.
reduc forall m: bitstring, k: key; sdec(senc(m, k), k) = m.

(* TLS-PRF session-key derivation from PBS + both nonces (fresh => fresh key). *)
fun prf(key, bitstring, bitstring): key.
(* handshake cryptograms proving knowledge of PBS over the nonces. *)
fun hostcrypto(key, bitstring, bitstring): bitstring.
fun optcrypto(key, bitstring, bitstring): bitstring.

free bus: channel.

event OptSent(bitstring, bitstring).
event HostAccepted(bitstring, bitstring).
event HostSent(bitstring, bitstring).
event OptAccepted(bitstring, bitstring).

(* SCOPE (added 2026-07-02, finding PM-3): NO `!` replication in this model — the
   optiga/host legs run a BOUNDED number of times, so the results hold for a SINGLE
   session, not across unbounded concurrent/replayed Shielded Connections. The
   Shielded-Connection sequence counter + the PBS-bound key derivation bound
   cross-session replay on-device; a `!`-replicated variant is the tracked
   follow-up. Not an unbounded-session guarantee. *)
(* OPTIGA: derive session key from PBS + nonces, authenticate the host, then
   release half_O over the channel (the F1D0/E120 gate is the host's auth). *)
let optiga(pbs: key, halfO: bitstring) =
    in(bus, hrnd: bitstring);                       (* host opens the connection *)
    new ornd: bitstring;
    let s = prf(pbs, hrnd, ornd) in
    event OptSent(hrnd, ornd);
    out(bus, (ornd, optcrypto(pbs, hrnd, ornd)));
    in(bus, hc: bitstring);
    if hc = hostcrypto(pbs, hrnd, ornd) then
    (
        event OptAccepted(hrnd, ornd);
        out(bus, senc(halfO, s))                    (* return half_O, wrapped *)
    ).

let host(pbs: key, halfO: bitstring) =
    new hrnd: bitstring;
    out(bus, hrnd);
    in(bus, (ornd: bitstring, oc: bitstring));
    let s = prf(pbs, hrnd, ornd) in
    if oc = optcrypto(pbs, hrnd, ornd) then          (* authenticate OPTIGA *)
    (
        event HostAccepted(hrnd, ornd);
        event HostSent(hrnd, ornd);
        out(bus, hostcrypto(pbs, hrnd, ornd))
    ).

(* event-free legs for the leaky residual scenario (auth would be spuriously
   forgeable once PBS leaks, so we scope the auth queries to the baseline). *)
let optigaL(pbs: key, halfO: bitstring) =
    in(bus, hrnd: bitstring);
    new ornd: bitstring;
    let s = prf(pbs, hrnd, ornd) in
    out(bus, (ornd, optcrypto(pbs, hrnd, ornd)));
    in(bus, hc: bitstring);
    if hc = hostcrypto(pbs, hrnd, ornd) then ( out(bus, senc(halfO, s)) ).

let hostL(pbs: key, halfO: bitstring) =
    new hrnd: bitstring;
    out(bus, hrnd);
    in(bus, (ornd: bitstring, oc: bitstring));
    let s = prf(pbs, hrnd, ornd) in
    if oc = optcrypto(pbs, hrnd, ornd) then ( out(bus, hostcrypto(pbs, hrnd, ornd)) ).

(* === BASELINE: pure bus attacker, no PBS leak. half_O secret + mutual auth. === *)
free pbsB:   key       [private].
free halfOB: bitstring [private].
query attacker(halfOB).
query h: bitstring, c: bitstring; event(HostAccepted(h, c)) ==> event(OptSent(h, c)).
query h: bitstring, c: bitstring; event(OptAccepted(h, c)) ==> event(HostSent(h, c)).
(* Anti-vacuity witnesses (finding F1/pv-se-1; mirrors the PM-2 fix in
   dual_se_unlock.pv). The baseline auth events MUST be reachable — else a dead
   honest leg turns both correspondences AND half_O secrecy vacuously-true while
   the count-only verify-protocol-models gate stays green. A reachable event query
   reports `is false`; both MUST stay false. (Mutation-demonstrated: breaking the
   baseline optiga leg left the gate at true=3/false=1 GREEN with the auth queries
   vacuously-true.) *)
query h: bitstring, c: bitstring; event(HostAccepted(h, c)).
query h: bitstring, c: bitstring; event(OptAccepted(h, c)).
let scenarioBaseline = ( optiga(pbsB, halfOB) | host(pbsB, halfOB) ).

(* === RESIDUAL: PBS leak (DHUK extraction, S2) + captured session => half_O
   recovered. Doubles as anti-vacuity. (Strictly weaker than the SCP03 PIN
   residual: half_O alone is useless by Claim 1.) === *)
free pbsR:   key       [private].
free halfOR: bitstring [private].
query attacker(halfOR).
let scenarioResidual =
    ( optigaL(pbsR, halfOR) | hostL(pbsR, halfOR) | out(bus, pbsR) ).

process ( scenarioBaseline | scenarioResidual )
