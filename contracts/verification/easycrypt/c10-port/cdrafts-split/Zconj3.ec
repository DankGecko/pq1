require import AllCore List FMap SPHINCS_PLUS.
lemma conjA (skFORSnt2 : FTWES.skFORS list list) (skFORSlp2 : FTWES.skFORS list) (j : int) :
  size skFORSlp2 = l' => 0 <= j < size skFORSlp2 =>
  0 <= size skFORSnt2 < size skFORSnt2 + 1 /\ 0 <= j < l'.
proof. by smt(). qed.
lemma conjB (ps2 : pseed) (skFORSnt2 : FTWES.skFORS list list) (j u v : int) :
true =>
  True.
proof. by []. qed.
