  "semantics": {
    "proposal_id": "signed queued-proposal key for upvote and signed dequeued-proposal key for referendum votes",
    "lesser": "signed post-update proposal-ID hint immediately behind the queue target, or zero at the tail boundary; not a vote weight or recipient",
    "greater": "signed post-update proposal-ID hint immediately ahead of the queue target, or zero at the head boundary; not a vote weight or recipient",
    "index": "signed position in the live dequeued array that must contain the same proposalId",
    "vote_enum": "Proposals.VoteValue is 0=None, 1=Abstain, 2=No, 3=Yes; vote rejects None",
    "upvote_weight": "live total locked CELO for the effective account; not present in upvote calldata",
    "revoke_target": "live proposal ID and recorded weight for the effective account; neither is present in revokeUpvote calldata",
    "whole_vote_weight": "live total governance voting power for the effective account, assigned wholly to the signed enum choice; not present in vote calldata",
    "partial_vote_weights": "signed yes/no/abstain weights whose sum is bounded by live total governance voting power",
    "caller": "msg.sender resolves through Accounts.voteSignerToAccount; the live effective account can differ from the immediate caller",
    "success_residual": "signer authorization, proposal existence/stage, queue/dequeued position, hint validity, live weights, sufficient voting power, and execution success remain live-state preconditions"
  },
