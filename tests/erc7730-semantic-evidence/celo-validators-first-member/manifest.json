  "abi": {
    "artifact": "abi/Validators.add-first-member.abi.json",
    "route_count": 1,
    "canonical_signature": "addFirstMember(address,address,address)",
    "selector": "0x3173b8db",
    "state_mutability": "nonpayable",
    "returns": "bool"
  },
  "semantics": {
    "validator": "signed registered validator account to add as the effective group's first member; affiliation and membership remain live state",
    "lesser": "signed address hint for a validator group with fewer live election votes than the effective group; not a member, recipient, or amount",
    "greater": "signed address hint for a validator group with more live election votes than the effective group; not a member, recipient, or amount",
    "caller": "msg.sender resolves through Accounts.validatorSignerToAccount; the live effective group can differ from the immediate caller",
    "effect": "after the first member is appended, Validators calls Election.markGroupEligible with the effective group and both signed hints",
    "success_residual": "group and validator registration, empty-group status, maximum group size, validator affiliation, duplicate membership, locked-gold requirements, live vote ordering, hint validity, and execution success remain live-state preconditions",
    "fixed_dependency_binding": "at the fixed block, Validators.registry(), Registry Accounts/Election selections, all three dependency proxy implementations, and both linked-library runtimes converge across three providers and bind to the archived sources"
  },
