  "semantics": {
    "native": "The call requires nonzero msg.value and a currently whitelisted signed receiver, emits the signed id/receiver/value, and forwards the complete value to that receiver or reverts.",
    "erc20": "The call requires nonzero signed token/amount and a currently whitelisted signed receiver, invokes safeTransferFrom(msg.sender, receiver, amount), and reports the receiver balance delta so fee-on-transfer output may be lower than the signed requested amount.",
