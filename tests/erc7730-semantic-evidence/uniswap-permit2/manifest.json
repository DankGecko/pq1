  "semantics": {
    "permit_single": {
      "signed_terminals": [
        "details.token",
        "details.amount",
        "details.expiration",
        "details.nonce",
        "spender",
        "sigDeadline"
      ],
      "successful_effect": "Replaces allowance[owner][token][spender] with the signed uint160 amount and expiration, then increments the matching uint48 nonce.",
      "expiration_zero": "The signed zero is stored as the current block timestamp, so it is not a Unix-epoch expiry.",
      "uint160_max": "AllowanceTransfer does not decrement type(uint160).max, making only that exact amount an unlimited reusable allowance."
    },
    "permit_batch": {
      "signed_terminals": [
        "details.[].token",
        "details.[].amount",
        "details.[].expiration",
        "details.[].nonce",
        "spender",
        "sigDeadline"
      ],
      "successful_effect": "Applies the PermitSingle allowance replacement and nonce increment independently to every signed details element."
    },
    "permit_transfer_from": {
      "signed_terminals": [
        "permitted.token",
        "permitted.amount",
        "spender",
        "nonce",
        "deadline"
      ],
      "spender_binding": "PermitHash inserts msg.sender as the signed spender.",
      "one_time_cap": "The unordered nonce is consumed once and requestedAmount must not exceed permitted.amount.",
      "unsigned_execution_fields": [
        "transferDetails.to",
        "transferDetails.requestedAmount"
      ],
      "residual": "The spender chooses the eventual recipient and requested amount when consuming the permit; the signed permitted.amount is a cap, not an exact transfer amount."
    },
    "signature_verification": {
      "eoa_branch": "claimedSigner.code.length == 0 uses ecrecover for 64- or 65-byte signatures.",
      "contract_branch": "Only a claimedSigner with deployed code is called through IERC1271.isValidSignature.",
      "residual": "The pinned implementation has no ERC-6492 unwrap path. Counterfactual or otherwise code-less contract accounts therefore do not reach ERC-1271 validation, and deployed contract code/state at validation time remains live execution state."
    }
  },
