    "primary_type": {
      "canonical_type": "feeApproval(uint256 chainId,uint256 fee,uint256 expiry)",
      "typehash": "0x40ac9f6aa27075e64c1ed1ea2e831b20b8c25efdeb6b79fd0cf683c9a9c50725"
    },
    "fee_semantics": "The signed fee is an LBTC-denominated maximum ceiling: AssetRouter verifies the digest over feeAction.fee, then charges min(configured maximumMintCommission, feeAction.fee)."
  },
  "semantics": {
    "redeem_intent": "request redemption; source burns caller LBTC after sending a mailbox request",
    "redeem_output": "no output amount, completion time, or successful release is signed",
    "permit": "all owner, spender, allowance, deadline, v, r, and s operands are visible; this is an ECDSA permit submission and not a PQ signature claim",
    "standards": "approve, transfer, and transferFrom inherit OpenZeppelin ERC-20 behavior; permit inherits OpenZeppelin ERC20Permit",
    "fee_approval": "getFeeDigest hashes the canonical feeApproval typehash with block.chainid, fee, and expiry under the StakedLBTC EIP-712 domain; AssetRouter treats signed fee as a maximum LBTC fee ceiling and may charge less",
    "fee_display": "production carries no authenticated ERC-20 metadata proof; mainnet identifies a maximum LBTC fee, labels the exact 256-bit raw base-unit word as hexadecimal, and never scales or rounds it",
    "dynamic_exclusions": "mint(bytes,bytes) and redeemForBtc(bytes,uint256) remain fail-closed because dynamic-tail clear signing is outside this phase"
  },
  "rpc": {
    "providers": [
      "dRPC",
      "Tenderly",
      "MEV Blocker"
    ],
    "historical_query_binding": "Every eth_getCode, eth_getStorageAt, and eth_call request uses EIP-1898 blockHash plus requireCanonical:true."
  },
  "boundary": "Historical fixed-block evidence covers six accepted flat-static calls and the feeApproval EIP-712 type at chain 1 proxy 0x8236a87084f8b84306f72007f36f2618a5634494. The signed fee is only a maximum LBTC ceiling; the actually charged fee, router configuration, routes, pause/access state, implementations, mailbox processing, output, timing, signature validity, and success remain mutable. No Sepolia feeApproval admission, dynamic calldata, Bitcoin-output validation, fallback, blind-sign, hardware, production, shipment, or future-upgrade authority is supplied.",
