  "semantics": [
    {
      "canonical_signature": "submit(address)",
      "source": [
        "source/Lido.sol:485-487",
        "source/Lido.sol:1025-1038"
      ],
      "successful_effect": "Requires nonzero msg.value and available live staking capacity, computes shares from live pooled-ETH/share state, mints those shares to msg.sender, increases buffered ether by exactly msg.value, and emits the exact sender, value, and signed referral.",
      "signed_display_binding": "@.value is the exact ETH input and #._referral is the exact full address word forwarded to _submit.",
      "output_residual": "The stETH share/token output is live-state-dependent and has no signed minimum."
    },
    {
      "canonical_signature": "stakeETH(address)",
      "source": [
        "source/WstethStaker.sol:43-60",
        "source/WstethStaker.sol:72-77"
      ],
      "successful_effect": "Forwards exact msg.value and the signed referral to stETH, converts returned shares to pooled ETH with ceiling division, wraps through the immutable canonical wstETH, and transfers the returned wstETH amount to msg.sender.",
      "signed_display_binding": "@.value is the exact forwarded ETH input and #._referral is the exact full address word; zero is explicitly allowed and means no referral.",
      "output_residual": "The wstETH output is live-state- and rounding-dependent and has no signed minimum."
    }
  ],
  "residuals": [
    "stETH is an upgradeable Aragon proxy; fixed-block implementation, kernel, appId, source, and runtime evidence do not guarantee future code.",
    "Both routes can revert because of zero value, pause/rate-limit, balance, allowance, external-call, or recipient behavior. Evidence describes successful source semantics, not transaction success.",
    "The resulting stETH/wstETH amount depends on live pooled-ETH/share state and rounding. PQ1 authenticates no minimum output or slippage bound for these routes.",
    "The archived RPC operators are independent endpoints, not independent chain histories or a live-monitoring service.",
    "This evidence grants no production-shipment, fallback, forced-blind, generic-signing, proxy-monitoring, or catalogue-expansion authority."
