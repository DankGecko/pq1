  "display": {
    "formats": {
      "sendTbtc(uint256 amount, uint16 recipientChain, bytes32 recipient, uint256 arbiterFee, uint32 nonce)": {
        "$id": "sendTbtc",
        "intent": "Bridge tBTC through Wormhole",
        "fields": [
          {
            "path": "amount",
            "label": "Requested tBTC",
            "format": "unit",
            "params": { "base": "tBTC", "decimals": 18, "prefix": false },
            "visible": "always"
          },
          {
            "value": "Sub-satoshi tBTC dust is not bridged or burned",
            "label": "Amount rounding",
            "format": "raw",
            "visible": "always"
          },
          {
            "path": "recipientChain",
            "label": "Wormhole destination",
            "format": "enum",
            "params": { "$ref": "$.metadata.enums.wormholeChain" },
            "visible": "always"
          },
          {
            "path": "recipient",
            "label": "Wormhole recipient",
            "format": "raw",
            "visible": "always"
          },
          {
            "path": "arbiterFee",
            "label": "Arbiter fee input",
            "format": "unit",
            "params": { "base": "tBTC", "decimals": 18, "prefix": false },
            "visible": "always"
          },
          {
            "value": "Ignored for registered tBTC gateway destinations",
            "label": "Arbiter fee rule",
            "format": "raw",
            "visible": "always"
          },
          {
            "path": "nonce",
            "label": "Wormhole batch nonce",
            "format": "raw",
            "visible": "always"
          },
          {
            "path": "@.value",
            "label": "Native message fee",
            "format": "amount",
            "visible": "always"
          }
        ]
      },
      "receiveTbtc(bytes encodedVm)": {
        "$id": "receiveTbtc",
        "intent": "Claim bridged tBTC",
        "fields": [
          {
            "path": "encodedVm",
            "label": "Wormhole VAA",
            "format": "raw",
            "visible": "always"
          }
        ]
      },
      "sendTbtcWithPayloadToNativeChain(uint256 amount, uint16 recipientNativeChain, bytes32 recipient, uint32 nonce, bytes payload)": {
        "$id": "sendTbtcWithPayloadToNativeChain",
        "intent": "Bridge tBTC with payload",
