{
  "$schema": "../../specs/erc7730-v2.schema.json",
  "_curation_note": "PQSigner semantic curation: five source-verified routes are admitted only for the fixed-block Ethereum RebateStaking proxy/implementation pair listed by deploymentFormats. token() binds every amount to Threshold Network Token (T) with 18 decimals. finalizeUnstaking shows the receiver and states that the transferred amount comes from the caller's pending unstake state; setDelegatee states the zero/self clearing behavior; fee mode 0 is corrected to deposits and redemptions. Every signed calldata operand is shown. Evidence is historical fixed-block source/runtime authority, not current stake/delegation/rebate state, transaction success, future proxy upgrades, fallback, or blind signing. See tests/erc7730-semantic-evidence/threshold.",
  "_pqsigner": {
    "deploymentFormats": [
      {
        "chainId": 1,
        "address": "0x0184739C32edc3471D3e4860c8E39a5f3Ff85A45",
        "formats": [
          "stake(uint96 amount)",
          "startUnstaking(uint96 amount)",
          "finalizeUnstaking(address receiver)",
          "setDelegatee(address _delegatee)",
          "setRebateTreasuryFeeMode(uint8 _rebateTreasuryFeeMode)"
        ]
      }
    ]
  },
  "context": {
    "$id": "Threshold Rebate Staking",
    "contract": {
      "deployments": [
        {
          "chainId": 1,
          "address": "0x0184739C32edc3471D3e4860c8E39a5f3Ff85A45"
        }
      ]
    }
  },
  "metadata": {
    "owner": "Threshold Network",
    "info": { "url": "https://threshold.network/" },
    "contractName": "RebateStaking",
    "enums": {
      "rebateTreasuryFeeMode": {
        "0": "Deposits and redemptions",
        "1": "Deposits only",
        "2": "Redemptions only"
      }
    }
  },
  "display": {
    "formats": {
      "stake(uint96 amount)": {
        "$id": "stake",
        "intent": "Stake T for fee rebates",
        "fields": [
          {
            "path": "amount",
            "label": "T to stake",
            "format": "unit",
            "params": { "base": "T", "decimals": 18, "prefix": false },
            "visible": "always"
          }
        ]
      },
      "startUnstaking(uint96 amount)": {
        "$id": "startUnstaking",
        "intent": "Start T unstake",
        "fields": [
          {
            "path": "amount",
            "label": "T to unstake",
            "format": "unit",
            "params": { "base": "T", "decimals": 18, "prefix": false },
            "visible": "always"
          }
        ]
      },
      "finalizeUnstaking(address receiver)": {
        "$id": "finalizeUnstaking",
        "intent": "Finalize pending T unstake",
        "fields": [
          {
            "path": "receiver",
            "label": "T receiver",
            "format": "addressName",
            "params": {
              "types": ["wallet", "eoa", "contract"],
              "sources": ["local", "ens"]
            },
            "visible": "always"
          },
          {
            "value": "Amount comes from pending unstake state",
            "label": "Transferred T",
            "format": "raw",
            "visible": "always"
          }
        ]
      },
      "setDelegatee(address _delegatee)": {
        "$id": "setDelegatee",
        "intent": "Update rebate delegatee",
        "fields": [
          {
            "path": "_delegatee",
            "label": "Delegatee",
            "format": "addressName",
            "params": {
              "types": ["wallet", "eoa", "contract"],
              "sources": ["local", "ens"]
            },
            "visible": "always"
          },
          {
            "value": "Zero or self clears delegation",
            "label": "Delegatee rule",
            "format": "raw",
            "visible": "always"
          }
        ]
      },
      "setRebateTreasuryFeeMode(uint8 _rebateTreasuryFeeMode)": {
        "$id": "setRebateTreasuryFeeMode",
        "intent": "Set fee-rebate mode",
        "fields": [
          {
            "path": "_rebateTreasuryFeeMode",
            "label": "Rebate eligibility",
            "format": "enum",
            "params": { "$ref": "$.metadata.enums.rebateTreasuryFeeMode" },
            "visible": "always"
          }
        ]
      }
    }
  }
}
