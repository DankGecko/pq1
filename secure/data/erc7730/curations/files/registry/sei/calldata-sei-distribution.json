      {
        "chainId": 1329,
        "address": "0x0000000000000000000000000000000000001007",
        "formats": [
          "setWithdrawAddress(address withdrawAddr)",
          "withdrawDelegationRewards(string validator)",
          "withdrawValidatorCommission()"
        ]
      }
    ],
    "refusalOnlyFormats": [
