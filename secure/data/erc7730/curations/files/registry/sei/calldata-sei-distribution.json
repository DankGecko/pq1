            "visible": "always"
          },
          { "label": "Reward amount", "format": "raw", "value": "Determined by live staking state" },
          { "label": "Payout to", "format": "raw", "value": "Configured Sei withdrawal address" }
        ]
      },
      "withdrawMultipleDelegationRewards(string[] validators)": {
