            "path": "#.validators.[]",
            "label": "Validators",
            "format": "raw",
            "visible": "always"
          },
          { "label": "Reward amounts", "format": "raw", "value": "Determined by live staking state" },
          { "label": "Payout to", "format": "raw", "value": "Configured Sei withdrawal address" }
        ]
      },
      "withdrawValidatorCommission()": {
        "intent": "Claim validator commission",
        "fields": [
          { "label": "Commission amount", "format": "raw", "value": "Determined by live validator state" },
          { "label": "Payout to", "format": "raw", "value": "Configured Sei withdrawal address" }
        ]
      }
