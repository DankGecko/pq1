{
  "$schema": "../../specs/erc7730-v2.schema.json",
  "_curation_note": "PQSigner semantic curation: four staking routes are admitted only for Sei EVM mainnet's native staking precompile below; createValidator remains an exact-known refusal because its five dynamic top-level arguments exceed the authenticated topology cap of four. At EVM block 222736384 the address had no EVM runtime or proxy storage, as expected for a native precompile. Independent live nodes reported Sei v6.5.0 and v6.5.2 builds whose target staking source and ABI are byte-identical; the official v6.5 upgrade was applied at height 208377745. Native value is exact wei and must be a whole usei; calldata stake amounts are usei with six decimals. Commission strings and every admitted validator, amount, and edit operand are shown. delegate, redelegate, and undelegate also claim live state-derived rewards to the configured Sei withdrawal address. Evidence is historical fixed-block/source authority, not live association, validator, reward, or withdrawal-address state, execution success, future native upgrades, fallback, or blind signing. See tests/erc7730-semantic-evidence/corestake-sei-avvatar.",
  "_pqsigner": {
    "deploymentFormats": [
      {
        "chainId": 1329,
        "address": "0x0000000000000000000000000000000000001005",
        "formats": [
          "delegate(string valAddress)",
          "editValidator(string moniker, string commissionRate, uint256 minSelfDelegation)",
          "redelegate(string srcAddress, string dstAddress, uint256 amount)",
          "undelegate(string valAddress, uint256 amount)"
        ]
      }
    ],
    "refusalOnlyFormats": [
      "createValidator(string pubKeyHex, string moniker, string commissionRate, string commissionMaxRate, string commissionMaxChangeRate, uint256 minSelfDelegation)"
    ]
  },
  "context": {
    "$id": "SeiStakingPrecompile",
    "contract": {
      "deployments": [
        { "chainId": 1329, "address": "0x0000000000000000000000000000000000001005" }
      ]
    }
  },
  "metadata": {
    "owner": "Sei",
    "contractName": "SeiStakingPrecompile",
    "info": { "url": "https://www.sei.io/" },
    "constants": {
      "nativeTokenTicker": "SEI",
      "nativeDecimals": 18
    }
  },
  "display": {
    "formats": {
      "createValidator(string pubKeyHex, string moniker, string commissionRate, string commissionMaxRate, string commissionMaxChangeRate, uint256 minSelfDelegation)": {
        "intent": "Create validator",
        "fields": [
          {
            "path": "#.pubKeyHex",
            "label": "Public key (hex)",
            "format": "raw",
            "visible": "always"
          },
          {
            "path": "#.moniker",
            "label": "Moniker",
            "format": "raw",
            "visible": "always"
          },
          {
            "path": "#.commissionRate",
            "label": "Commission rate",
            "format": "raw",
            "visible": "always"
          },
          {
            "path": "#.commissionMaxRate",
            "label": "Max commission rate",
            "format": "raw",
            "visible": "always"
          },
          {
            "path": "#.commissionMaxChangeRate",
            "label": "Max commission change rate",
            "format": "raw",
            "visible": "always"
          },
          {
            "path": "#.minSelfDelegation",
            "label": "Min self delegation",
            "format": "unit",
            "params": { "base": "SEI", "decimals": 6 },
            "visible": "always"
          },
          {
            "path": "@.value",
            "label": "Self stake amount",
            "format": "amount",
            "visible": "always"
          },
          { "label": "Value precision", "format": "raw", "value": "Must be a whole usei (6 decimals)" }
        ]
      },
      "delegate(string valAddress)": {
        "intent": "Delegate",
        "fields": [
          {
            "path": "#.valAddress",
            "label": "Validator",
            "format": "raw",
            "visible": "always"
          },
          {
            "path": "@.value",
            "label": "Amount",
            "format": "amount",
            "visible": "always"
          },
          { "label": "Reward side effect", "format": "raw", "value": "Claims this validator's live rewards" },
          { "label": "Reward payout to", "format": "raw", "value": "Configured Sei withdrawal address" }
        ]
      },
      "editValidator(string moniker, string commissionRate, uint256 minSelfDelegation)": {
        "intent": "Edit validator",
        "fields": [
          {
            "path": "#.moniker",
            "label": "Moniker",
            "format": "raw",
            "visible": "always"
          },
          {
            "path": "#.commissionRate",
            "label": "Commission rate",
            "format": "raw",
            "visible": "always"
          },
          {
            "path": "#.minSelfDelegation",
            "label": "Min self delegation",
            "format": "unit",
            "params": { "base": "SEI", "decimals": 6 },
            "visible": "always"
          },
          { "label": "Unchanged values", "format": "raw", "value": "Empty commission; minimum 0" }
        ]
      },
      "redelegate(string srcAddress, string dstAddress, uint256 amount)": {
        "intent": "Redelegate",
        "fields": [
          {
            "path": "#.srcAddress",
            "label": "Source validator",
            "format": "raw",
            "visible": "always"
          },
          {
            "path": "#.dstAddress",
            "label": "Target validator",
            "format": "raw",
            "visible": "always"
          },
          {
            "path": "#.amount",
            "label": "Amount",
            "format": "unit",
            "params": { "base": "SEI", "decimals": 6 },
            "visible": "always"
          },
          { "label": "Reward side effect", "format": "raw", "value": "Claims source and target live rewards" },
          { "label": "Reward payout to", "format": "raw", "value": "Configured Sei withdrawal address" }
        ]
      },
      "undelegate(string valAddress, uint256 amount)": {
        "intent": "Undelegate",
        "fields": [
          {
            "path": "#.valAddress",
            "label": "Validator",
            "format": "raw",
            "visible": "always"
          },
          {
            "path": "#.amount",
            "label": "Amount",
            "format": "unit",
            "params": { "base": "SEI", "decimals": 6 },
            "visible": "always"
          },
          { "label": "Reward side effect", "format": "raw", "value": "Claims this validator's live rewards" },
          { "label": "Reward payout to", "format": "raw", "value": "Configured Sei withdrawal address" }
        ]
      }
    }
  }
}
