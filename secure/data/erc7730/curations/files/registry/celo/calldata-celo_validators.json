          "deregisterValidatorGroup(uint256 index)",
          "registerValidatorGroup(uint256 commission)",
          "removeMember(address validator)",
          "reorderMember(address validator, address lesserMember, address greaterMember)",
          "resetSlashingMultiplier()"
        ]
      },
      {
        "chainId": 44787,
        "address": "0x9acF2A99914E083aD0d610672E93d14b0736BBCc",
        "formats": [
          "addMember(address validator)",
          "affiliate(address group)",
          "deaffiliate()",
          "deregisterValidator(uint256 index)",
          "deregisterValidatorGroup(uint256 index)",
          "registerValidatorGroup(uint256 commission)",
          "removeMember(address validator)",
          "reorderMember(address validator, address lesserMember, address greaterMember)",
          "resetSlashingMultiplier()"
        ]
      }
