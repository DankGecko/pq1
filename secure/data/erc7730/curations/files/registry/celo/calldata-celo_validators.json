{
  "$schema": "https://github.com/LedgerHQ/clear-signing-erc7730-registry/blob/master/specs/erc7730-v2.schema.json",
  "_curation_note": "PQSigner semantic curation: addFirstMember(address,address,address) is admitted only for the Registry-selected Celo mainnet Validators proxy, while the legacy Alfajores deployment preserves exactly its nine previously compiled formats. The trusted display shows the validator and both signed vote-order group hints, discloses that the effective group comes from signer mapping, and states the successful-call eligibility effect. Evidence is historical fixed-block authority, not live signer mapping, affiliation, empty-group state, locked-gold requirements, vote ordering, execution success, or future proxy-upgrade monitoring. See tests/erc7730-semantic-evidence/celo-validators-first-member.",
  "_pqsigner": {
