{
  "$schema": "../../specs/erc7730-v2.schema.json",
  "includes": "common-AggregationRouterV4.json",
  "_curation_note": "PQSigner semantic curation: only the two static Clipper swaps are admitted for the independently verified Ethereum AggregationRouterV4 deployment. Its deployed ClipperRouter treats address zero, and not the shared 0xEeee sentinel, as native currency; both amount fields therefore authenticate only address zero for these routes. clipperSwap binds the recipient to msg.sender and clipperSwapTo displays the explicit recipient. clipperSwapToWithPermit remains declared only to preserve an exact known-call refusal because hidden permit bytes can change token authority. The inherited aggregation executor, packed pool lists, permit siblings, RFQ orders, owner controls, and every other ambiguous or dynamic route remain excluded by deploymentFormats and fail closed as exact known calls. Evidence is historical fixed-block source/runtime authority, not quote quality, execution success, current bytecode, future deployment monitoring, fallback, or blind signing.",
  "_pqsigner": {
    "deploymentFormats": [
      {
        "chainId": 1,
        "address": "0x1111111254fb6c44bAC0beD2854e76F90643097d",
        "formats": [
          "clipperSwap(address srcToken, address dstToken, uint256 amount, uint256 minReturn)",
          "clipperSwapTo(address recipient, address srcToken, address dstToken, uint256 amount, uint256 minReturn)"
        ]
      }
    ]
  },
  "context": {
    "$id": "AggregationRouterV4",
    "contract": { "deployments": [{ "chainId": 1, "address": "0x1111111254fb6c44bAC0beD2854e76F90643097d" }] }
  },
  "display": {
    "formats": {
      "clipperSwap(address srcToken, address dstToken, uint256 amount, uint256 minReturn)": {
        "$id": "clipperSwap",
        "intent": "Swap",
        "fields": [
          {
            "path": "amount",
            "$ref": "$.display.definitions.sendAmount",
            "params": {
              "tokenPath": "srcToken",
              "nativeCurrencyAddress": ["$.metadata.constants.addressAsNull"]
            },
            "visible": "always"
          },
          {
            "path": "minReturn",
            "$ref": "$.display.definitions.minReceiveAmount",
            "params": {
              "tokenPath": "dstToken",
              "nativeCurrencyAddress": ["$.metadata.constants.addressAsNull"]
            },
            "visible": "always"
          },
          { "path": "@.from", "$ref": "$.display.definitions.beneficiary", "visible": "always" }
        ]
      },
      "clipperSwapTo(address recipient, address srcToken, address dstToken, uint256 amount, uint256 minReturn)": {
        "$id": "clipperSwapTo",
        "intent": "Swap",
        "fields": [
          {
            "path": "amount",
            "$ref": "$.display.definitions.sendAmount",
            "params": {
              "tokenPath": "srcToken",
              "nativeCurrencyAddress": ["$.metadata.constants.addressAsNull"]
            },
            "visible": "always"
          },
          {
            "path": "minReturn",
            "$ref": "$.display.definitions.minReceiveAmount",
            "params": {
              "tokenPath": "dstToken",
              "nativeCurrencyAddress": ["$.metadata.constants.addressAsNull"]
            },
            "visible": "always"
          },
          { "path": "recipient", "$ref": "$.display.definitions.beneficiary", "visible": "always" }
        ]
      },
      "clipperSwapToWithPermit(address recipient, address srcToken, address dstToken, uint256 amount, uint256 minReturn, bytes permit)": {
        "$id": "clipperSwapToWithPermit",
        "intent": "Unsupported Clipper permit swap",
        "fields": [
          { "path": "recipient", "label": "Recipient", "format": "raw", "visible": "always" },
          { "path": "srcToken", "label": "Source token", "format": "raw", "visible": "always" },
          { "path": "dstToken", "label": "Destination token", "format": "raw", "visible": "always" },
          { "path": "amount", "label": "Amount raw", "format": "raw", "visible": "always" },
          { "path": "minReturn", "label": "Minimum raw", "format": "raw", "visible": "always" },
          { "path": "permit", "label": "Permit bytes", "format": "raw", "visible": "always" }
        ]
      }
    }
  },
  "metadata": { "contractName": "AggregationRouterV4" }
}
