{
  "$schema": "../../specs/erc7730-v2.schema.json",
  "_curation_note": "PQSigner semantic curation: only deposit(uint256,address) is admitted for the fixed Ethereum AllocatorVault proxy below. It shows the exact USDe spend and receiver, while warning that stk-USDe output depends on live rates and fees and has no signed minimum. mint remains an exact known-call refusal because its USDe spend is computed from live state with no signed maximum. withdraw and redeem remain exact known-call refusals because the fixed-block configuration has cooldown enabled, so they transfer state-derived sUSDe strategy shares rather than the advertised exact USDe output; their burned-share or output amount is also state-derived. Evidence pins the Blockscout-verified implementation, EIP-1967 slot, runtime, underlying USDe, sUSDe strategy, and fixed-block configuration. It is historical authority, not future proxy/configuration/runtime, rate, fee, balance, allowance, or execution-success authority.",
  "_pqsigner": {
    "deploymentFormats": [
      {
        "chainId": 1,
        "address": "0x2D152fB171353E70e45322D32bC748F8a61d9971",
        "formats": ["deposit(uint256 _underlying, address receiver)"]
      }
    ],
    "refusalOnlyFormats": [
      "mint(uint256 shares, address receiver)",
      "redeem(uint256 shares, address receiver, address owner)",
      "withdraw(uint256 _underlying, address receiver, address owner)"
    ]
  },
