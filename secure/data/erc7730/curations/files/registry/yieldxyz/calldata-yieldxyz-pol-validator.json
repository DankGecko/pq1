  "display": {
    "formats": {
      "buyVoucherPOL(uint256 _amount, uint256 _minSharesToMint)": {
        "intent": "Stake POL",
        "fields": [
          {
            "path": "#._amount",
            "label": "Maximum POL deposited",
            "format": "unit",
            "params": { "base": "$.metadata.constants.stakingTokenTicker", "decimals": 18 },
            "visible": "always"
          },
          { "path": "#._minSharesToMint", "label": "Minimum shares", "format": "raw", "visible": "always" },
          { "label": "Rounding", "format": "raw", "value": "Actual POL may round down to whole shares" },
          { "label": "Additional effect", "format": "raw", "value": "Also claims accrued POL rewards" }
        ]
      },
      "sellVoucher_newPOL(uint256 claimAmount, uint256 maximumSharesToBurn)": {
        "intent": "Queue POL unstake",
        "fields": [
          {
            "path": "#.claimAmount",
            "label": "Requested POL",
            "format": "unit",
            "params": { "base": "$.metadata.constants.stakingTokenTicker", "decimals": 18 },
            "visible": "always"
          },
          { "path": "#.maximumSharesToBurn", "label": "Maximum shares burned", "format": "raw", "visible": "always" },
          { "label": "Additional effect", "format": "raw", "value": "Also claims accrued POL rewards" },
          { "label": "Final payout", "format": "raw", "value": "Uses the live withdrawal exchange rate" }
        ]
      },
      "unstakeClaimTokens_newPOL(uint256 unbondNonce)": {
        "intent": "Claim unstaked POL",
        "fields": [
          { "path": "#.unbondNonce", "label": "Unbond nonce", "format": "raw", "visible": "always" },
          {
            "path": "@.from",
            "label": "POL recipient",
            "format": "addressName",
            "params": { "types": ["eoa", "contract"] },
            "visible": "always"
          },
          { "label": "Claim amount", "format": "raw", "value": "Comes from queued state and the live withdrawal rate" }
        ]
      },
      "withdrawRewardsPOL()": {
        "intent": "Withdraw POL rewards",
        "fields": [
          {
            "path": "@.from",
            "label": "POL recipient",
            "format": "addressName",
            "params": { "types": ["eoa", "contract"] },
            "visible": "always"
          },
          { "label": "Reward amount", "format": "raw", "value": "Comes from accrued caller state" }
        ]
      }
    }
  }
