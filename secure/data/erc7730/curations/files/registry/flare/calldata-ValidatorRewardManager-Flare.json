{
  "$schema": "../../specs/erc7730-v2.schema.json",
  "_curation_note": "PQSigner semantic curation: all three ValidatorRewardManager routes are admitted only for the fixed Flare direct deployment below. claim shows the exact reward owner, recipient, signed FLR amount, and native-versus-wrapped payout choice. The two configuration routes show every address and state explicitly that the supplied list replaces the caller's full executor or allowed-recipient set, including empty-list clearing. Evidence pins the direct runtime, official Flare Explorer verified source/ABI, zero standard proxy slots, and fixed-block WNat/active configuration. It is historical authority, not live reward balance, authorization/list state, execution success, future code/configuration changes, fallback, or blind-signing authority.",
  "_pqsigner": {
    "deploymentFormats": [
      {
        "chainId": 14,
        "address": "0xc0CF3Aaf93bd978C5BC662564Aa73E331f2eC0B5",
        "formats": [
          "claim(address _rewardOwner, address _recipient, uint256 _rewardAmount, bool _wrap)",
          "setClaimExecutors(address[] _executors)",
          "setAllowedClaimRecipients(address[] _recipients)"
        ]
      }
    ]
  },
  "context": {
    "$id": "ValidatorRewardManager-Flare",
    "contract": {
      "deployments": [
        {
          "chainId": 14,
          "address": "0xc0CF3Aaf93bd978C5BC662564Aa73E331f2eC0B5"
        }
      ]
    }
  },
  "metadata": {
    "owner": "Flare Labs",
    "info": {
      "url": "https://flare.network/"
    },
    "contractName": "ValidatorRewardManager-Flare",
    "enums": {
      "payout": {
        "0": "Native FLR",
        "1": "Wrapped FLR"
      }
    }
  },
  "display": {
    "formats": {
      "claim(address _rewardOwner, address _recipient, uint256 _rewardAmount, bool _wrap)": {
        "intent": "Claim validator reward",
        "fields": [
          {
            "label": "Reward owner",
            "format": "addressName",
            "params": {
              "types": [
                "eoa",
                "wallet",
                "contract"
              ]
            },
            "path": "#._rewardOwner",
            "visible": "always"
          },
          {
            "label": "Recipient",
            "format": "addressName",
            "params": {
              "types": [
                "eoa",
                "wallet",
                "contract"
              ]
            },
            "path": "#._recipient",
            "visible": "always"
          },
          {
            "label": "Reward amount",
            "format": "amount",
            "path": "#._rewardAmount",
            "visible": "always"
          },
          {
            "label": "Payout",
            "format": "enum",
            "params": {
              "$ref": "$.metadata.enums.payout"
            },
            "path": "#._wrap",
            "visible": "always"
          }
        ]
      },
      "setClaimExecutors(address[] _executors)": {
        "intent": "Replace claim executors",
        "fields": [
          {
            "label": "Executor",
            "format": "addressName",
            "params": {
              "types": [
                "eoa",
                "wallet",
                "contract"
              ]
            },
            "path": "#._executors.[]",
            "visible": "always"
          },
          {
            "label": "Effect",
            "format": "raw",
            "value": "Replace full list; empty clears all",
            "visible": "always"
          }
        ]
      },
      "setAllowedClaimRecipients(address[] _recipients)": {
        "intent": "Replace allowed recipients",
        "fields": [
          {
            "label": "Recipient",
            "format": "addressName",
            "params": {
              "types": [
                "eoa",
                "wallet",
                "contract"
              ]
            },
            "path": "#._recipients.[]",
            "visible": "always"
          },
          {
            "label": "Effect",
            "format": "raw",
            "value": "Replace full list; owner remains allowed",
            "visible": "always"
          }
        ]
      }
    }
  }
}
