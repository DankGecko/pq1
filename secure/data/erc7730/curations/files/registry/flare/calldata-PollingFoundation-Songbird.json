{
  "$schema": "../../specs/erc7730-v2.schema.json",
  "_curation_note": "PQSigner semantic curation: castVote and the non-executable text/settings proposal overload are admitted only for the fixed Songbird direct deployment below. Votes render the exact proposal ID and source-defined Against/For enum. Non-executable proposals render the complete description and every settings operand and state that the source supplies empty target/value/calldata arrays. The executable proposal overload remains an exact known-call refusal because arbitrary bytes[] calls cannot be rendered injectively by the authenticated calldata topology. Evidence pins the direct runtime, official Songbird Explorer verified source/ABI, and zero standard proxy slots. It is historical authority, not live proposal/vote power/eligibility state, execution success, future code/configuration changes, fallback, or blind-signing authority.",
  "_pqsigner": {
    "deploymentFormats": [
      {
        "chainId": 19,
        "address": "0x79Df47237292Dbd1477502CFF3F61cD535B0FAce",
        "formats": [
          "castVote(uint256 _proposalId, uint8 _support)",
          "propose(string _description, (bool accept, uint256 votingStartTs, uint256 votingPeriodSeconds, uint256 vpBlockPeriodSeconds, uint256 thresholdConditionBIPS, uint256 majorityConditionBIPS) _settings)"
        ]
      }
    ],
    "refusalOnlyFormats": [
      "propose(address[] _targets, uint256[] _values, bytes[] _calldatas, string _description, (bool accept, uint256 votingStartTs, uint256 votingPeriodSeconds, uint256 vpBlockPeriodSeconds, uint256 thresholdConditionBIPS, uint256 majorityConditionBIPS, uint256 executionDelaySeconds, uint256 executionPeriodSeconds) _settings)"
    ]
  },
  "context": {
    "$id": "PollingFoundation-Songbird",
    "contract": {
      "deployments": [
        {
          "chainId": 19,
          "address": "0x79Df47237292Dbd1477502CFF3F61cD535B0FAce"
        }
      ]
    }
  },
  "metadata": {
    "owner": "Flare Labs",
    "info": {
      "url": "https://flare.network/"
    },
    "contractName": "PollingFoundation-Songbird",
    "enums": {
      "vote": {
        "0": "Against",
        "1": "For"
      },
      "proposalType": {
        "0": "Reject proposal",
        "1": "Accept proposal"
      }
    }
  },
  "display": {
    "formats": {
      "castVote(uint256 _proposalId, uint8 _support)": {
        "intent": "Cast foundation vote",
        "fields": [
          {
            "label": "Proposal ID",
            "format": "raw",
            "path": "#._proposalId",
            "visible": "always"
          },
          {
            "label": "Vote",
            "format": "enum",
            "params": {
              "$ref": "$.metadata.enums.vote"
            },
            "path": "#._support",
            "visible": "always"
          }
        ]
      },
      "propose(address[] _targets, uint256[] _values, bytes[] _calldatas, string _description, (bool accept, uint256 votingStartTs, uint256 votingPeriodSeconds, uint256 vpBlockPeriodSeconds, uint256 thresholdConditionBIPS, uint256 majorityConditionBIPS, uint256 executionDelaySeconds, uint256 executionPeriodSeconds) _settings)": {
        "intent": "Create executable proposal",
        "fields": [
          {
            "label": "Targets",
            "format": "addressName",
            "params": {
              "types": [
                "wallet",
                "eoa",
                "contract",
                "token",
                "collection"
              ]
            },
            "path": "#._targets.[]",
            "visible": "always"
          },
          {
            "label": "Values",
            "format": "amount",
            "path": "#._values.[]",
            "visible": "always"
          },
          {
            "label": "Calldatas",
            "format": "raw",
            "path": "#._calldatas.[]",
            "visible": "always"
          },
          {
            "label": "Description",
            "format": "raw",
            "path": "#._description",
            "visible": "always"
          },
          {
            "path": "#._settings",
            "fields": [
              {
                "label": "Proposal type",
                "format": "enum",
                "params": {
                  "$ref": "$.metadata.enums.proposalType"
                },
                "path": "accept",
                "visible": "always"
              },
              {
                "label": "Voting start",
                "format": "date",
                "params": {
                  "encoding": "timestamp"
                },
                "path": "votingStartTs",
                "visible": "always"
              },
              {
                "label": "Voting period",
                "format": "duration",
                "path": "votingPeriodSeconds",
                "visible": "always"
              },
              {
                "label": "Vote-power lookback",
                "format": "duration",
                "path": "vpBlockPeriodSeconds",
                "visible": "always"
              },
              {
                "label": "Threshold",
                "format": "unit",
                "params": {
                  "base": "bps"
                },
                "path": "thresholdConditionBIPS",
                "visible": "always"
              },
              {
                "label": "Majority",
                "format": "unit",
                "params": {
                  "base": "bps"
                },
                "path": "majorityConditionBIPS",
                "visible": "always"
              },
              {
                "label": "Execution delay",
                "format": "duration",
                "path": "executionDelaySeconds",
                "visible": "always"
              },
              {
                "label": "Execution period",
                "format": "duration",
                "path": "executionPeriodSeconds",
                "visible": "always"
              }
            ]
          }
        ]
      },
      "propose(string _description, (bool accept, uint256 votingStartTs, uint256 votingPeriodSeconds, uint256 vpBlockPeriodSeconds, uint256 thresholdConditionBIPS, uint256 majorityConditionBIPS) _settings)": {
        "intent": "Create non-executable poll",
        "fields": [
          {
            "label": "Description",
            "format": "raw",
            "path": "#._description",
            "visible": "always"
          },
          {
            "path": "#._settings",
            "fields": [
              {
                "label": "Proposal type",
                "format": "enum",
                "params": {
                  "$ref": "$.metadata.enums.proposalType"
                },
                "path": "accept",
                "visible": "always"
              },
              {
                "label": "Voting start",
                "format": "date",
                "params": {
                  "encoding": "timestamp"
                },
                "path": "votingStartTs",
                "visible": "always"
              },
              {
                "label": "Voting period",
                "format": "duration",
                "path": "votingPeriodSeconds",
                "visible": "always"
              },
              {
                "label": "Vote-power lookback",
                "format": "duration",
                "path": "vpBlockPeriodSeconds",
                "visible": "always"
              },
              {
                "label": "Threshold",
                "format": "unit",
                "params": {
                  "base": "bps"
                },
                "path": "thresholdConditionBIPS",
                "visible": "always"
              },
              {
                "label": "Majority",
                "format": "unit",
                "params": {
                  "base": "bps"
                },
                "path": "majorityConditionBIPS",
                "visible": "always"
              }
            ]
          },
          {
            "label": "Execution calls",
            "format": "raw",
            "value": "None; source supplies empty call arrays",
            "visible": "always"
          }
        ]
      }
    }
  }
}
