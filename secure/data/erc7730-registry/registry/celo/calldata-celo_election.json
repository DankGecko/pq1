{
  "$schema": "https://github.com/LedgerHQ/clear-signing-erc7730-registry/blob/master/specs/erc7730-v2.schema.json",
  "_curation_note": "PQSigner semantic curation: vote(address,uint256,address,address) and the three revoke routes are admitted only for the Registry-selected Celo mainnet Election proxy, while the legacy Alfajores deployment preserves only its two previously admitted activation routes. Every signed operand is shown: validator group, exact pending or active CELO amount when calldata carries one, both sorted-list position hints, and voting-list index. revokeAllActive does not fabricate an amount absent from its calldata. Evidence is historical fixed-block authority, not live eligibility, ordering, balance, execution-success, or future proxy-upgrade monitoring. See tests/erc7730-semantic-evidence/celo-election-vote.",
  "_pqsigner": {
    "deploymentFormats": [
      {
        "chainId": 42220,
        "address": "0x8D6677192144292870907E3Fa8A5527fE55A7ff6",
        "formats": [
          "activate(address group)",
          "activateForAccount(address group, address account)",
          "revokeActive(address group, uint256 value, address lesser, address greater, uint256 index)",
          "revokeAllActive(address group, address lesser, address greater, uint256 index)",
          "revokePending(address group, uint256 value, address lesser, address greater, uint256 index)",
          "vote(address group, uint256 value, address lesser, address greater)"
        ]
      },
      {
        "chainId": 44787,
        "address": "0x1c3eDf937CFc2F6F51784D20DEB1af1F9a8655fA",
        "formats": [
          "activate(address group)",
          "activateForAccount(address group, address account)"
        ]
      }
    ]
  },
  "context": {
    "$id": "Celo Election",
    "contract": {
      "deployments": [
        { "chainId": 42220, "address": "0x8D6677192144292870907E3Fa8A5527fE55A7ff6" },
        { "chainId": 44787, "address": "0x1c3eDf937CFc2F6F51784D20DEB1af1F9a8655fA" }
      ]
    }
  },
  "metadata": { "owner": "Celo", "info": { "url": "https://celo.org/" }, "contractName": "Celo Election" },
  "display": {
    "formats": {
      "activate(address group)": {
        "$id": "activate",
        "intent": "Activate",
        "fields": [
          {
            "path": "group",
            "label": "Validator Group",
            "format": "addressName",
            "params": { "types": ["contract"] },
            "visible": "always"
          },
          { "path": "@.from", "label": "Vote signer", "format": "addressName", "params": { "types": ["eoa"] }, "visible": "always" }
        ]
      },
      "activateForAccount(address group, address account)": {
        "$id": "activateForAccount",
        "intent": "Activate Votes",
        "fields": [
          {
            "path": "group",
            "label": "Validator Group",
            "format": "addressName",
            "params": { "types": ["contract"] },
            "visible": "always"
          },
          {
            "path": "account",
            "label": "Account",
            "format": "addressName",
            "params": { "types": ["contract", "eoa"] },
            "visible": "always"
          }
        ]
      },
      "revokeActive(address group, uint256 value, address lesser, address greater, uint256 index)": {
        "$id": "revokeActive",
        "intent": "Revoke Active Votes",
        "fields": [
          {
            "path": "group",
            "label": "Validator Group",
            "format": "addressName",
            "params": { "types": ["eoa", "contract"] },
            "visible": "always"
          },
          { "path": "value", "label": "Active CELO to Revoke", "format": "amount", "visible": "always" },
          {
            "path": "lesser",
            "label": "Fewer-Vote Hint",
            "format": "addressName",
            "params": { "types": ["eoa", "contract"] },
            "visible": "always"
          },
          {
            "path": "greater",
            "label": "More-Vote Hint",
            "format": "addressName",
            "params": { "types": ["eoa", "contract"] },
            "visible": "always"
          },
          { "path": "index", "label": "Voting List Index", "format": "raw", "visible": "always" }
        ]
      },
      "revokeAllActive(address group, address lesser, address greater, uint256 index)": {
        "$id": "revokeAllActive",
        "intent": "Revoke All Active Votes",
        "fields": [
          {
            "path": "group",
            "label": "Validator Group",
            "format": "addressName",
            "params": { "types": ["eoa", "contract"] },
            "visible": "always"
          },
          {
            "path": "lesser",
            "label": "Fewer-Vote Hint",
            "format": "addressName",
            "params": { "types": ["eoa", "contract"] },
            "visible": "always"
          },
          {
            "path": "greater",
            "label": "More-Vote Hint",
            "format": "addressName",
            "params": { "types": ["eoa", "contract"] },
            "visible": "always"
          },
          { "path": "index", "label": "Voting List Index", "format": "raw", "visible": "always" }
        ]
      },
      "revokePending(address group, uint256 value, address lesser, address greater, uint256 index)": {
        "$id": "revokePending",
        "intent": "Revoke Pending Votes",
        "fields": [
          {
            "path": "group",
            "label": "Validator Group",
            "format": "addressName",
            "params": { "types": ["eoa", "contract"] },
            "visible": "always"
          },
          { "path": "value", "label": "Pending CELO to Revoke", "format": "amount", "visible": "always" },
          {
            "path": "lesser",
            "label": "Fewer-Vote Hint",
            "format": "addressName",
            "params": { "types": ["eoa", "contract"] },
            "visible": "always"
          },
          {
            "path": "greater",
            "label": "More-Vote Hint",
            "format": "addressName",
            "params": { "types": ["eoa", "contract"] },
            "visible": "always"
          },
          { "path": "index", "label": "Voting List Index", "format": "raw", "visible": "always" }
        ]
      },
      "vote(address group, uint256 value, address lesser, address greater)": {
        "$id": "vote",
        "intent": "Vote",
        "fields": [
          {
            "path": "group",
            "label": "Validator Group",
            "format": "addressName",
            "params": { "types": ["eoa", "contract"] },
            "visible": "always"
          },
          { "path": "value", "label": "CELO to Vote", "format": "amount", "visible": "always" },
          {
            "path": "lesser",
            "label": "Fewer-Vote Hint",
            "format": "addressName",
            "params": { "types": ["eoa", "contract"] },
            "visible": "always"
          },
          {
            "path": "greater",
            "label": "More-Vote Hint",
            "format": "addressName",
            "params": { "types": ["eoa", "contract"] },
            "visible": "always"
          }
        ]
      }
    }
  }
}
