{
  "$schema": "../../specs/erc7730-v2.schema.json",
  "_curation_note": "PQSigner semantic curation: all signed terminal fields are shown for PermitSingle, PermitBatch, and PermitTransferFrom. Reusable allowances label expiration as raw `Expiry (0=now)` because Permit2 stores zero as the current block timestamp, and only the exact uint160 maximum renders as Unlimited. PermitTransferFrom is described as a one-time spender pull cap: its eventual recipient and requested amount are deliberately unsigned and are not implied by the display. Permit2 ERC-1271 validation requires owner code at validation time and does not unwrap ERC-6492. See tests/erc7730-semantic-evidence/uniswap-permit2.",
  "includes": "uniswap-common-eip712.json",
  "display": {
    "formats": {
      "PermitSingle(PermitDetails details,address spender,uint256 sigDeadline)PermitDetails(address token,uint160 amount,uint48 expiration,uint48 nonce)": {
        "$id": "Permit2 Permit Single",
        "intent": "Authorize spending of token",
        "fields": [
          {
            "path": "spender",
            "label": "Spender",
            "format": "raw",
            "visible": "always"
          },
          {
            "path": "details.amount",
            "label": "Allowance",
            "format": "tokenAmount",
            "params": {
              "tokenPath": "details.token",
              "threshold": "0x000000000000000000000000ffffffffffffffffffffffffffffffffffffffff",
              "message": "Unlimited"
            },
            "visible": "always"
          },
          {
            "path": "details.expiration",
            "label": "Expiry (0=now)",
            "format": "raw",
            "visible": "always"
          },
          {
            "path": "details.nonce",
            "label": "Allowance nonce",
            "format": "raw",
            "visible": "always"
          },
          {
            "path": "sigDeadline",
            "label": "Sig deadline",
            "format": "date",
            "params": {
              "encoding": "timestamp"
            },
            "visible": "always"
          }
        ]
      },
      "PermitBatch(PermitDetails[] details,address spender,uint256 sigDeadline)PermitDetails(address token,uint160 amount,uint48 expiration,uint48 nonce)": {
        "$id": "Permit2 Permit Batch",
        "intent": "Authorize spending of tokens",
        "fields": [
          {
            "path": "spender",
            "label": "Spender",
            "format": "raw",
            "visible": "always"
          },
          {
            "path": "details.[].amount",
            "label": "Allowance",
            "format": "tokenAmount",
            "params": {
              "tokenPath": "details.[].token",
              "threshold": "0x000000000000000000000000ffffffffffffffffffffffffffffffffffffffff",
              "message": "Unlimited"
            },
            "visible": "always"
          },
          {
            "path": "details.[].expiration",
            "label": "Expiry (0=now)",
            "format": "raw",
            "visible": "always"
          },
          {
            "path": "details.[].nonce",
            "label": "Allowance nonce",
            "format": "raw",
            "visible": "always"
          },
          {
            "path": "sigDeadline",
            "label": "Sig deadline",
            "format": "date",
            "params": {
              "encoding": "timestamp"
            },
            "visible": "always"
          }
        ]
      },
      "PermitTransferFrom(TokenPermissions permitted,address spender,uint256 nonce,uint256 deadline)TokenPermissions(address token,uint256 amount)": {
        "$id": "Permit2 Permit Transfer",
        "intent": "Authorize one-time token pull",
        "fields": [
          {
            "path": "spender",
            "label": "Spender",
            "format": "addressName",
            "params": {
              "types": [
                "contract"
              ],
              "sources": [
                "local",
                "ens"
              ]
            },
            "visible": "always"
          },
          {
            "path": "permitted.amount",
            "label": "Maximum transfer",
            "format": "tokenAmount",
            "params": {
              "tokenPath": "permitted.token",
              "threshold": "0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff",
              "message": "Any amount"
            },
            "visible": "always"
          },
          {
            "path": "deadline",
            "label": "Deadline",
            "format": "date",
            "params": {
              "encoding": "timestamp"
            },
            "visible": "always"
          },
          {
            "label": "Nonce",
            "path": "nonce",
            "format": "raw",
            "visible": "always"
          }
        ]
      }
    }
  }
}
