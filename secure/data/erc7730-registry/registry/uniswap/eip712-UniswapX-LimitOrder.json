{
  "$schema": "../../specs/erc7730-v2.schema.json",
  "includes": "uniswap-common-eip712.json",
  "_curation_note": "PQSigner Tier-A curation (v3 nested-EIP-712): the upstream descriptor hides the whole `witness.info` (OrderInfo) struct with visible:\"never\". PQSigner's WYSIWYS belt REFUSES a hidden address behind a trusted clear-sign, so we SHOW the OrderInfo addresses (reactor, swapper, additionalValidationContract) and keep only the non-address order metadata hidden. The output tokenPath is authored ABSOLUTE (witness.outputs.[].token). LimitOrder's element struct is OutputToken(token, amount, recipient) — 3 members, no decay/startAmount. See docs/erc7730-nested-eip712-render-design.md §12.",
  "display": {
    "formats": {
      "PermitWitnessTransferFrom(TokenPermissions permitted,address spender,uint256 nonce,uint256 deadline,LimitOrder witness)LimitOrder(OrderInfo info,address inputToken,uint256 inputAmount,OutputToken[] outputs)OrderInfo(address reactor,address swapper,uint256 nonce,uint256 deadline,address additionalValidationContract,bytes additionalValidationData)OutputToken(address token,uint256 amount,address recipient)TokenPermissions(address token,uint256 amount)": {
        "intent": "UniswapX Limit Order",
        "fields": [
          { "path": "spender", "label": "Approve to spender", "format": "raw" },
          {
            "path": "permitted.amount",
            "label": "Amount allowance",
            "format": "tokenAmount",
            "params": { "tokenPath": "permitted.token" }
          },
          {
            "path": "witness.inputAmount",
            "label": "Send",
            "format": "tokenAmount",
            "params": { "tokenPath": "witness.inputToken" }
          },
          {
            "path": "witness.info",
            "fields": [
              { "path": "reactor", "label": "Order reactor", "format": "raw" },
              { "path": "swapper", "label": "Order swapper", "format": "raw" },
              { "path": "nonce", "label": "Order nonce", "visible": "never" },
              { "path": "deadline", "label": "Order deadline", "visible": "never" },
              { "path": "additionalValidationContract", "label": "Validation contract", "format": "raw" },
              { "path": "additionalValidationData", "label": "Validation data", "visible": "never" }
            ]
          },
          {
            "path": "witness.outputs.[]",
            "fields": [
              { "path": "amount", "label": "Min amount to receive", "format": "tokenAmount", "params": { "tokenPath": "witness.outputs.[].token" } },
              { "path": "recipient", "label": "On Address", "format": "raw" }
            ]
          },
          { "path": "deadline", "label": "Approval expire", "format": "date", "params": { "encoding": "timestamp" } },
          { "label": "Nonce", "path": "nonce", "visible": "never" }
        ]
      }
    }
  }
}
